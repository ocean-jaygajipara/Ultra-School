{
  "info": {
    "name": "Ultra School Student App APIs 20-11-2026",
    "description": "Flutter student app APIs only (20-11-2026).\n\nSplash, Login, Dashboard, Academic, Complaint, Contact, Fees, Personal Details, Request, Notifications.\n\nHeaders: school_code, Authorization Bearer {{token}}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api" },
    { "key": "token", "value": "" },
    { "key": "school_id", "value": "ues" },
    { "key": "admission_id", "value": "2502" },
    { "key": "mobile", "value": "8528549049" },
    { "key": "otp", "value": "" },
    { "key": "fcm_token", "value": "" },
    { "key": "request_subject_id", "value": "1" },
    { "key": "notification_id", "value": "1" },
    { "key": "fee_receipt_id", "value": "1" }
  ],
  "item": [
    {
      "name": "1. Splash / Auth",
      "item": [
        {
          "name": "1.1 Schools",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/schools"
          }
        },
        {
          "name": "1.2 Send OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  const j = pm.response.json();",
                  "  if (j && j.data) {",
                  "    if (j.data.admission_id) pm.collectionVariables.set('admission_id', String(j.data.admission_id));",
                  "    if (j.data.otp) pm.collectionVariables.set('otp', String(j.data.otp));",
                  "  }",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"school_key\": \"{{school_id}}\",\n  \"gr_no\": {{admission_id}},\n  \"mobile_no\": \"{{mobile}}\",\n  \"fcm_token\": \"{{fcm_token}}\",\n  \"device_details\": \"Flutter App\"\n}"
            },
            "url": "{{base_url}}/send-otp"
          }
        },
        {
          "name": "1.3 Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  const j = pm.response.json();",
                  "  if (j && j.token) pm.collectionVariables.set('token', j.token);",
                  "  else if (j && j.data && j.data.token) pm.collectionVariables.set('token', j.data.token);",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"school_key\": \"{{school_id}}\",\n  \"gr_no\": {{admission_id}},\n  \"mobile_no\": \"{{mobile}}\",\n  \"otp\": \"{{otp}}\",\n  \"fcm_token\": \"{{fcm_token}}\",\n  \"device_details\": \"Flutter App\"\n}"
            },
            "url": "{{base_url}}/verify-otp",
            "description": "Saves Bearer token automatically."
          }
        },
        {
          "name": "1.4 Auth Detail",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "school_code", "value": "{{school_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcm_token\": \"{{fcm_token}}\"\n}"
            },
            "url": "{{base_url}}/student/auth-detail",
            "description": "Optional body fcm_token — saves Firebase device token for push."
          }
        }
      ]
    },
