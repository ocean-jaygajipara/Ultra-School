    {
      "name": "6. Fees",
      "item": [
        {
          "name": "6.1 Fee Receipt List",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  const j = pm.response.json();",
                  "  if (j && j.data && Array.isArray(j.data.details) && j.data.details.length && j.data.details[0].id) {",
                  "    pm.collectionVariables.set('fee_receipt_id', String(j.data.details[0].id));",
                  "  }",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "school_code", "value": "{{school_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{base_url}}/student/fee-receipt-list",
            "description": "Summary: total / paid / pending from Fee Master (FIRST+SECOND).\nterms[] = term, total, paid, pending, status (Paid|Pending).\ndetails[] = paid receipts with education_fee_url / vehicle_fee_url.\nNo Fee Master for year+standard → total/paid/pending = 0 and terms/details empty.\nExample: FIRST paid → SECOND shows in pending."
          }
        }
      ]
